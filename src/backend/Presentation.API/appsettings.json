{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "DistribucionPolar.API",
    "Audience": "DistribucionPolar.Clients",
    "ExpirationMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Business": {
