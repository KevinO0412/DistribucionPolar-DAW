{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "DistribucionPolar.API.Staging",
    "Audience": "DistribucionPolar.Clients.Staging",
    "ExpirationMinutes": 120
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "GlobalPermitLimit": 600
  }
}
